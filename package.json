{
  "name": "3evo-router",
  "version": "1.0.0",
  "description": "Local AI gateway with failover and encrypted secrets",
  "main": "index.js",
  "bin": {
    "3evo-router": "./dist/index.js"
  },
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 20128",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 20128",
    "test": "vitest run",
    "pkg": "pkg . --targets node18-win-x64,node18-macos-x64,node18-linux-x64 --output dist/3evo-router",
    "pkg:win": "pkg . --targets node18-win-x64 --output dist/3evo-router.exe",
    "pkg:mac": "pkg . --targets node18-macos-x64 --output dist/3evo-router-macos",
    "pkg:linux": "pkg . --targets node18-linux-x64 --output dist/3evo-router-linux"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "pkg": "^5.8.1",
    "vitest": "^5.0.5"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      ".next/**/*",
      "locales/**/*"
    ],
    "scripts": "dist/**/*.js",
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-linux-x64"
    ],
    "outputPath": "dist"
  }
}
